# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/synthetica?retryWrites=true&w=majority
# Or for local development:
# MONGODB_URI=mongodb://127.0.0.1:27017/synthetica

# Inference Worker Microservice URL
AI_WORKER_URL=http://localhost:8000

# Dialectic Consensus Threshold (0.0 to 1.0)
CONVERGENCE_THRESHOLD=0.85
CONSECUTIVE_CONVERGENCE_TURNS=2

# Delay between auto turns in milliseconds (default 2500ms)
TURN_DELAY_MS=2500
